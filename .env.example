# Safe local development examples. Copy to .env and keep real secrets out of Git.
TAMFORGE_ENV=development
TAMFORGE_DATABASE_URL=postgresql+asyncpg://tamforge:tamforge@127.0.0.1:54329/tamforge
TAMFORGE_OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
TAMFORGE_OBJECT_STORE_BUCKET=tam-forge-local
TAMFORGE_GITHUB_USER_ID=102269369

# Secrets and deployment-specific identifiers stay blank until configured.
TAMFORGE_OBJECT_STORE_ACCESS_KEY=
TAMFORGE_OBJECT_STORE_SECRET_KEY=
TAMFORGE_GITHUB_CLIENT_ID=
TAMFORGE_GITHUB_CLIENT_SECRET=
TAMFORGE_SESSION_SIGNING_SECRET=
