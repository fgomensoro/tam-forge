# The post-Gastos TAM Forge host, as a contract. No secrets live here.
# Every value is checked by infra/host/contract.py before any script runs.
TAMFORGE_HOST_RELEASE=24.04
TAMFORGE_HOST_ARCH=x86_64
TAMFORGE_HOST_NAME=tamforge-prod
TAMFORGE_HOST_IP=46.224.232.77
TAMFORGE_HOST_PROVIDER_ID=hetzner-server-2
TAMFORGE_APP_HOSTNAME=app.tamforge.example
TAMFORGE_SSH_SOURCE_CIDR=0.0.0.0/0
TAMFORGE_PUBLIC_PORTS=22,80,443
TAMFORGE_LOOPBACK_PORTS=5432,8000
TAMFORGE_HOST_RAM_MB=3819
TAMFORGE_SAFETY_RESERVE_MB=1024
# Package pins, verified against apt policy before install.
TAMFORGE_PKG_POSTGRESQL=postgresql-16
TAMFORGE_PKG_PGVECTOR=postgresql-16-pgvector
TAMFORGE_PKG_CADDY=caddy
TAMFORGE_PKG_UFW=ufw
# Unix identities. No service runs as root.
TAMFORGE_SERVICE_USERS=tamforge-api,tamforge-worker,tamforge-speech,tamforge-claude,tamforge-embedding,tamforge-backup
TAMFORGE_SHARED_GROUP=tamforge
# Per-service memory budgets in MB; the sum plus the reserve must fit the host.
TAMFORGE_BUDGET_API_MB=512
TAMFORGE_BUDGET_WORKER_MB=512
TAMFORGE_BUDGET_SPEECH_MB=768
TAMFORGE_BUDGET_CLAUDE_MB=256
TAMFORGE_BUDGET_EMBEDDING_MB=512
TAMFORGE_RELEASES_DIR=/opt/tamforge/releases
TAMFORGE_CURRENT_LINK=/opt/tamforge/current
TAMFORGE_CONFIG_DIR=/etc/tamforge
TAMFORGE_STATE_DIR=/var/lib/tamforge
TAMFORGE_CACHE_DIR=/var/cache/tamforge
