# TAM Forge speech-worker. Budgets come from infra/config/host-layout.env; do not edit on the host.
[Unit]
Description=TAM Forge speech-worker
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
# Ingest and study stay up when Claude or transcription is degraded: no Requires= on them.

[Service]
Type=simple
User=tamforge-speech
Group=tamforge
WorkingDirectory=/opt/tamforge/current
ExecStart=/opt/tamforge/current/.venv/bin/python -m tamforge_backend.workers.speech
EnvironmentFile=/etc/tamforge/speech-worker.env
# ProtectHome makes /home unreadable, and asyncpg probes ~/.postgresql before every
# connection; a readable HOME keeps that probe a clean miss.
Environment=HOME=%S/tamforge/speech-worker
LoadCredential=recording-manifest-keyring.json:/etc/tamforge/secrets/recording-manifest-keyring.json
Restart=on-failure
RestartSec=5s
SyslogIdentifier=tamforge-speech-worker
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

# Resource budget (MB from the host contract)
MemoryMax=768M
MemoryHigh=691M
CPUQuota=100%
TasksMax=256
LimitNOFILE=4096

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RuntimeDirectory=tamforge/speech
RuntimeDirectoryMode=0750
StateDirectory=tamforge/speech
CacheDirectory=tamforge/speech
ReadWritePaths=/var/lib/tamforge/shared

[Install]
WantedBy=multi-user.target
